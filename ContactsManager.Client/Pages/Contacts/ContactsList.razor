@page "/"
@using ContactsManager.Client.Services.IServices
@inject IContactService ContactService

<PageTitle>Lista kontaktów</PageTitle>

<h1 class="fw-bolder pb-2">Lista kontaktów:</h1>


@if(isLoading)
{
	<p>Ładowanie...</p>
}
else if(contacts == null || contacts.Count == 0)
{
	<h3 class="pb-2">Brak kontaktów</h3>
}
else
{
	<div class="row row-cols-1 row-cols-md-2 gy-0 gx-3">
		@foreach (var contact in contacts)
		{
			<_ContactCard @key="contact.Id" Contact="contact" />
		}
	</div>
}

@code {
	private IReadOnlyList<ContactPublicDTO> contacts = [];
	private bool isLoading = true;

	protected override async Task OnInitializedAsync()
	{
		contacts = await ContactService.GetAllContactsAsync();
		isLoading = false;
	}
}

