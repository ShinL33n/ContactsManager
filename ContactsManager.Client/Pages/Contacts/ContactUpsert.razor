@page "/upsert/{Id:guid}"
@using ContactsManager.Client.Services
@using ContactsManager.Client.Services.IServices
@inject IContactService ContactService
@inject NavigationManager Navigation

<h3>ContactUpsert</h3>

<PageTitle>Edytuj/utwórz kontakt</PageTitle>

<a href="/contact/@Id" class="btn btn-sm btn-outline-accent mb-3">&larr; Wróć do szczegółów</a>

<h1 class="fw-bolder pb-2">Edytuj/utórz kontakt:</h1>

<_ContactForm contact="contact" />

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public ContactPublicDTO? contact { get; set; } = null;

    // TO-DO: dto for update/create contact

    protected override async Task OnInitializedAsync()
    {
        contact = await ContactService.GetContactDetailsByIdAsync(Id);
        if (contact == null)
        {
            Navigation.NotFound();
        }
    }
}
